# Apply one binary patch everywhere it is needed.
#   $1 heading   $2 dist-locator function   $3 DLL basename   $4 engine verb
# Both Proton dists and per-game prefixes are targets: Proton gives each prefix
# its own copy of these DLLs, and the prefix copy is the one the game loads.
patch_dlls() {
  local title="$1" locate="$2" base="$3" verb="$4"
  head_ "$title"
  local targets=() g f real d
  declare -A seen=()

  if (( OPT_ALL_PROTONS )); then
    while read -r d; do
      [[ -n "$d" ]] || continue
      while read -r f; do [[ -n "$f" ]] && targets+=("$f"); done < <("$locate" "$d")
    done < <(py protons "$STEAM_ROOT" | python3 -I -c 'import json,sys; [print(p["dir"]) for p in json.load(sys.stdin)]')
  else
    for g in "${GAMES[@]}"; do
      load_game "$g"
      while read -r f; do [[ -n "$f" ]] && targets+=("$f"); done < <("$locate" "${G_PROTON_DIR[$g]}")
    done
  fi
  for g in "${GAMES[@]}"; do
    load_game "$g"
    [[ -n "${G_PREFIX[$g]}" && -e "${G_PREFIX[$g]}/drive_c/windows/system32/$base" ]] \
      && targets+=("${G_PREFIX[$g]}/drive_c/windows/system32/$base")
  done

  if (( ! ${#targets[@]} )); then
    warn "nothing to patch — no Proton dist or prefix found"
    return 0
  fi

  local n_done=0
  for f in "${targets[@]}"; do
    real="$(readlink -f "$f" 2>/dev/null || printf '%s' "$f")"
    # Prefix DLLs are often symlinks into a shared Proton dist. Patch each real
    # file once, and say so, rather than appearing to patch two things.
    if [[ -n "${seen[$real]:-}" ]]; then continue; fi
    seen[$real]=1
    printf '  %s\n' "$(tilde "$f")"
    [[ "$real" != "$f" ]] && note "-> $(tilde "$real")"
    if (( OPT_DRY )); then
      note "would apply: $(py "$verb-state" "$f")"
      continue
    fi
    local msg rc=0
    if [[ "$verb" == dll ]]; then
      # Only the setupapi patch has a 32-bit variant to opt into.
      msg="$(py dll-patch "$f" "$( ((OPT_32)) && echo 32 || echo 64 )" 2>&1)" || rc=$?
    else
      msg="$(py "$verb-patch" "$f" 2>&1)" || rc=$?
    fi
    if (( rc )); then note "${c_err}$msg${c_off}"; PROBLEMS=$((PROBLEMS+1)); else note "$msg"; n_done=$((n_done+1)); fi
  done
  (( n_done )) && ok "$n_done file(s) handled"
  return 0
}

do_patch() {
  patch_dlls "setupapi stub patch"            dist_dlls   setupapi.dll dll
  patch_dlls "MessageBoxA NULL-caption patch" dist_user32 user32.dll   msg
}

do_launch_opts() {
