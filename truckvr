  for g in "${GAMES[@]}"; do
    load_game "$g"
    [[ -n "${G_PREFIX[$g]}" ]] && printf '%s\n' "${G_PREFIX[$g]}/drive_c/windows/system32/$base"
  done
}

# Undo one binary patch wherever it was applied.
#   $1 dist-locator function   $2 DLL basename   $3 engine verb
revert_dlls() {
  local locate="$1" base="$2" verb="$3"
  local f real
  declare -A seen=()
  while read -r f; do
    [[ -n "$f" && -e "$f" ]] || continue
    real="$(readlink -f "$f")"
    [[ -n "${seen[$real]:-}" ]] && continue
    seen[$real]=1
    # Touch only what we actually changed: either truckvr left a backup beside
    # it, or the file still carries the patch — the un-patch can rebuild the
    # original either way. Anything else is someone else's file.
    py dll-backup "$f" >/dev/null 2>&1 \
      || [[ "$(py "$verb-state" "$f" 2>/dev/null)" == PATCHED* ]] \
      || continue
    if (( OPT_DRY )); then warn "would restore $(tilde "$real")"
    else printf '  %s\n' "$(tilde "$real")"; note "$(py "$verb-unpatch" "$f")"; fi
  done < <(revert_targets "$locate" "$base")
}

do_revert() {
  head_ "Reverting"
  local g f real
  declare -A seen=()
  for g in "${GAMES[@]}"; do
    load_game "$g"
    [[ -n "${G_TMP[$g]}" && -f "${G_TMP[$g]}" ]] && {
      if (( OPT_DRY )); then warn "would clear VR flags for ${GAME_NAME[$g]}"
      else py tmp-set "${G_TMP[$g]}" "$g" 0 "${VR_FLAGS[@]}" >/dev/null && ok "${GAME_NAME[$g]}: VR flags removed"; fi
    }
  done
  revert_dlls dist_dlls   setupapi.dll dll
  revert_dlls dist_user32 user32.dll   msg
  note "the OpenXR runtime file and Steam launch options were left alone —"
  note "remove them by hand if you want a completely clean slate:"
  note "$(tilde "$XR_RUNTIME")"
}

# --------------------------------------------------------------------- doctor

do_doctor() {
  local g
  printf '\n%struckvr %s%s  %s%s%s\n' "$c_hd" "$VERSION" "$c_off" "$c_dim" "$(tilde "$STEAM_ROOT")" "$c_off"
  [[ -n "${EXTRA_ROOTS:-}" ]] && note "other Steam installs ignored: $(tilde "$(tr '\n' ' ' <<<"$EXTRA_ROOTS")")"

  head_ "Headset / OpenXR"
  local xr; xr="$(py xr-state "$XR_RUNTIME")"
  case "$xr" in
    WIVRN*)   ok "OpenXR runtime: WiVRn"; note "$(tilde "${xr#WIVRN }")" ;;
    STEAMVR*) bad "OpenXR runtime: SteamVR has taken it over"
              note "SteamVR replaces this file and deletes it on exit."
              note "fix: $SELF runtime   (and do not run SteamVR alongside WiVRn)" ;;
    MONADO*)  warn "OpenXR runtime: Monado (not WiVRn)"; note "fix: $SELF runtime" ;;
    MISSING)  bad "OpenXR runtime: not configured"
              note "the game will not find a headset. fix: $SELF runtime" ;;
    BROKEN)   bad "OpenXR runtime: $(tilde "$XR_RUNTIME") is not valid JSON"
              note "fix: $SELF runtime" ;;
    *)        warn "OpenXR runtime: unrecognised (${xr#* })"; note "fix: $SELF runtime" ;;
  esac
  # This env var beats the config file outright, so a stale one silently
  # overrides everything this script writes.
  if [[ -n "${XR_RUNTIME_JSON:-}" ]]; then
    warn "XR_RUNTIME_JSON is set — it overrides $(tilde "$XR_RUNTIME")"
    note "${XR_RUNTIME_JSON}"
    note "unset it, or point it at the WiVRn manifest, or the game will use that instead"
  fi
  if py wivrn-lib >/dev/null 2>&1; then
    ok "WiVRn installed"
  else
    bad "WiVRn not found"
    note "flatpak install flathub io.github.wivrn.wivrn"
  fi
  # A sandboxed Steam has its own view of $HOME, so the runtime file we write
  # on the host may simply not exist as far as the game is concerned.
  case "$STEAM_ROOT" in
    */.var/app/com.valvesoftware.Steam/*|*/snap/steam/*)
      warn "Steam is sandboxed (Flatpak/Snap)"
      note "it may not see $(tilde "$XR_RUNTIME"). Grant access with e.g."
      note "flatpak override --user --filesystem=xdg-config/openxr:ro com.valvesoftware.Steam"
      note "and --filesystem=~/.local/share/flatpak/app/io.github.wivrn.wivrn:ro" ;;
  esac
  if wivrn_running; then ok "WiVRn server: running"
  else note "WiVRn server: not running (start it before launching the game)"; fi
  steamvr_running && { bad "SteamVR is running"; note "close it — it steals the OpenXR runtime from WiVRn"; }
  steam_running && note "Steam is running (launch options cannot be edited while it is)"

  for g in "${GAMES[@]}"; do
    load_game "$g"
    head_ "${GAME_NAME[$g]}  ${c_dim}(appid ${GAME_APPID[$g]})${c_off}"

    if [[ -z "${G_INSTALL[$g]}" ]]; then
      warn "not installed in any Steam library"
      continue
    fi
    ok "installed: $(tilde "${G_INSTALL[$g]}")"

    if [[ -z "${G_PREFIX[$g]}" ]]; then
      warn "no Proton prefix yet — launch it from Steam once"
    fi

    # --- mode
    local tmp="${G_TMP[$g]}" opts=""
    if [[ -n "$tmp" && -f "$tmp" ]]; then
      opts="$(py tmp-get "$tmp" "$g" 2>/dev/null || true)"
      if [[ " $opts " == *" -openxr "* ]]; then
        ok "mode: VR   ${c_dim}(TruckersMP flags: $opts)${c_off}"
      else
        warn "mode: flat ${c_dim}(TruckersMP flags: ${opts:-none})${c_off}"
        note "fix: $SELF on $g"
      fi
    else
      note "TruckersMP not configured for this game (fine if you play singleplayer)"
    fi

    # --- launch options
    local c cur found=0
    while read -r c; do
      [[ -n "$c" ]] || continue
      cur="$(py launch-get "$c" "${GAME_APPID[$g]}" 2>/dev/null || true)"
      [[ "$cur" == *"PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES=1"* ]] && found=1
    done < <(py launch-profiles "$STEAM_ROOT" "${GAME_APPID[$g]}")
    if (( found )); then
      ok "Steam launch options: pressure-vessel import is set"
    else
      bad "Steam launch options: missing $PV_VAR"
      note "without it the game cannot see WiVRn from inside Steam's container"
      note "fix: close Steam, then $SELF install"
    fi

    # --- proton
    local pn="${G_PROTON_NAME[$g]}"
    if [[ -z "$pn" ]]; then
      bad "Proton: could not determine which build runs this game"
      note "set one in Steam > Properties > Compatibility"
    else
      case "${G_VR[$g]}" in
        yes) ok "Proton: $pn ${c_dim}(${G_VR_WHY[$g]})${c_off}" ;;
        no)  bad "Proton: $pn — too old for VR"
             note "${G_VR_WHY[$g]}"
             note "the game will render stereo on the monitor while the headset"
             note "stays on the WiVRn lobby. pick one marked VR in: $SELF protons" ;;
        *)   warn "Proton: $pn — cannot tell if it has the VR fix"
             note "${G_VR_WHY[$g]}"
             note "if it is newer than 2026-07-07 it is almost certainly fine" ;;
      esac
      [[ -n "${G_CHAIN[$g]}" ]] && note "resolved via: ${G_CHAIN[$g]}"
      [[ -z "${G_PROTON_DIR[$g]}" ]] && {
        bad "Proton '$pn' is not installed anywhere this script can see"
        note "it may have been deleted or renamed. see: $SELF protons"; }
    fi

    # --- setupapi
    if [[ -n "$tmp" && -f "$tmp" ]]; then
      local dll st pfx_dll
      dll="$(dist_dlls "${G_PROTON_DIR[$g]}" | head -1)"
      pfx_dll="${G_PREFIX[$g]}/drive_c/windows/system32/setupapi.dll"
      local s_dist="n/a" s_pfx="n/a"
      [[ -n "$dll" ]] && s_dist="$(py dll-state "$dll")"
      [[ -e "$pfx_dll" ]] && s_pfx="$(py dll-state "$pfx_dll")"
      # A build that forwards the export elsewhere, or that finally implements
      # it, needs no patch at all — that is a pass, not a failure.
      local nofix_re='^(PATCHED|FORWARDED|IMPLEMENTED|NOEXPORT)'
      if [[ "$s_dist" =~ $nofix_re && ( "$s_pfx" =~ $nofix_re || "$s_pfx" == n/a ) ]]; then
        if [[ "$s_dist" == PATCHED* ]]; then ok "setupapi stub: patched"
        else ok "setupapi stub: no patch needed ${c_dim}($s_dist)${c_off}"; fi
      elif [[ "$s_dist" == "n/a" && "$s_pfx" =~ $nofix_re ]]; then
        warn "setupapi stub: prefix patched, but the active Proton dist is not"
        note "a Proton update or a prefix rebuild will undo it. fix: $SELF patch"
      else
        bad "setupapi stub: dist=$s_dist prefix=$s_pfx"
        note "TruckersMP will abort at the login screen. fix: $SELF patch"
      fi
      if [[ -L "$pfx_dll" ]]; then
        note "prefix DLL is a symlink -> $(tilde "$(readlink -f "$pfx_dll")")"
      fi
    fi

    # --- user32 MessageBoxA NULL caption
    if [[ -n "$tmp" && -f "$tmp" ]]; then
      local u_dist u_pfx s_udist="n/a" s_upfx="n/a"
      u_dist="$(dist_user32 "${G_PROTON_DIR[$g]}" | head -1)"
      u_pfx="${G_PREFIX[$g]}/drive_c/windows/system32/user32.dll"
      [[ -n "$u_dist" ]] && s_udist="$(py msg-state "$u_dist")"
      [[ -e "$u_pfx"  ]] && s_upfx="$(py msg-state "$u_pfx")"
      # NOTPRESENT means this build has no Star Citizen hack to trip over, which
      # is a pass, not a failure.
      local msg_ok_re='^(PATCHED|NOTPRESENT|MISSING)'
      if [[ "$s_upfx" == PATCHED* && "$s_udist" == UNPATCHED* ]]; then
        warn "MessageBoxA NULL caption: prefix patched, but the Proton dist is not"
        note "a Proton update or a prefix rebuild will undo it. fix: $SELF patch"
      elif [[ "$s_udist" =~ $msg_ok_re && ( "$s_upfx" =~ $msg_ok_re || "$s_upfx" == n/a ) ]]; then
        if [[ "$s_udist" == PATCHED* || "$s_upfx" == PATCHED* ]]; then
          ok "MessageBoxA NULL caption: patched"
        else
          ok "MessageBoxA NULL caption: no patch needed ${c_dim}($s_udist)${c_off}"
        fi
      else
        bad "MessageBoxA NULL caption: dist=$s_udist prefix=$s_upfx"
        note "TruckersMP dies with C0000005 in strcmp instead of showing its"
        note "error dialog, a couple of seconds into startup. fix: $SELF patch"
      fi
    fi
  done

  head_ "Summary"
  if (( PROBLEMS )); then
    bad "$PROBLEMS problem(s) found — run '$SELF install' to fix what can be fixed automatically"
  elif (( WARNINGS )); then
    ok "no blocking problems ($WARNINGS warning(s))"
  else
    ok "everything checks out"
  fi
  printf '\n%sStart WiVRn, connect the headset, then launch the game from Steam.\n' "$c_dim"
  printf 'The headset sits on the WiVRn lobby for the first ~35s — that is normal.\n'
  printf 'In game: F11 toggles VR, F12 recenters.%s\n\n' "$c_off"
  (( PROBLEMS )) && return 1 || return 0
}

do_install() {
  local g
  printf '\n%struckvr %s — setting up VR%s\n' "$c_hd" "$VERSION" "$c_off"
  if game_running; then
    warn "a truck game is running — changes take effect at the next launch"
  fi
  do_runtime || true
  do_patch
  do_launch_opts
  do_mode 1
  for g in "${GAMES[@]}"; do
    load_game "$g"
    if [[ "${G_VR[$g]}" == no ]]; then
      head_ "Proton"
      bad "${GAME_NAME[$g]} is set to ${G_PROTON_NAME[$g]}, which cannot do VR"
      note "${G_VR_WHY[$g]}"
      note "pick a build marked VR from '$SELF protons', then either set it in"
      note "Steam > Properties > Compatibility, or in SteamTinkerLaunch if you use it."
    fi
  done
  PROBLEMS=0; WARNINGS=0
  do_doctor
}

# ---------------------------------------------------------------------- main

case "$CMD" in
  version|--version) say "truckvr $VERSION"; exit 0 ;;
esac

discover_steam

case "$CMD" in
  doctor|status|check) do_doctor ;;
  install|setup)       do_install ;;
  on|vr|enable)        do_mode 1; PROBLEMS=0; WARNINGS=0; do_doctor ;;
  off|flat|disable)    do_mode 0; PROBLEMS=0; WARNINGS=0; do_doctor ;;
  patch)               do_patch ;;
  runtime|xr)          do_runtime ;;
  protons|proton)      do_protons ;;
  revert|uninstall)    do_revert ;;
  *)                   die "unknown command '$CMD' (try $SELF --help)" ;;
esac
