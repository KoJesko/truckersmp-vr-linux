  # is still on disk in older builds. The copy under share/default_pfx is a
  # symlink into these, so patching here also covers prefixes created later.
  for f in "$d"/files/lib/wine/x86_64-windows/"$base" \
           "$d"/files/lib64/wine/x86_64-windows/"$base" \
           "$d"/dist/lib/wine/x86_64-windows/"$base" \
           "$d"/dist/lib64/wine/x86_64-windows/"$base"; do
    [[ -f "$f" ]] && { printf '%s\n' "$f"; return 0; }
  done
  return 0
}

